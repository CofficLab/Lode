    "The row locator matched multiple rows. This table has duplicate rows and no primary key, so a single target cannot be determined." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The row locator matched multiple rows. This table has duplicate rows and no primary key, so a single target cannot be determined."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行定位匹配到多行。该表存在重复行且无主键，因此无法确定唯一目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列定位匹配到多列。該表存在重複列且無主鍵，因此無法確定唯一目標。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
