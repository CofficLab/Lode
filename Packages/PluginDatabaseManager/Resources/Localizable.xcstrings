    "This connection is read-only. Structure changes are blocked. Edit the connection to change its safe mode." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection is read-only. Structure changes are blocked. Edit the connection to change its safe mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此连接为只读，结构变更已被拦截。编辑连接可更改其安全模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此連線為唯讀，結構變更已被攔截。編輯連線可變更其安全模式。"
